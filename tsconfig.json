{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2019",
    "lib": ["es2019", "es2020", "es2022.error"],
    "types": ["node"],
    "removeComments": true,
    "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // Deliberately NOT incremental. `npm run build` wipes dist/ but a build-info
    // cache lives outside it and survives, so tsc would decide nothing changed
    // and emit nothing — leaving an EMPTY dist that lint cannot see, because
    // lint reads sources. `prepublishOnly` runs that same build, so a publish
    // from a machine that had built before would ship a package whose node
    // never loads. A full emit of a dozen files costs about a second.
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "./dist/"
  },
  "include": ["credentials/**/*", "nodes/**/*"],
  "exclude": ["node_modules", "dist"]
}
